# Shared local defaults
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Auth / NextAuth
NEXTAUTH_SECRET=replace-with-a-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Convex local development
CONVEX_DEPLOYMENT=replace-with-convex-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://replace-with-your-convex-url.convex.cloud

# Optional production/preview deploy key for Convex deploys
CONVEX_DEPLOY_KEY=replace-with-convex-deploy-key

# Live poker / Cloudflare Durable Objects
NEXT_PUBLIC_LIVE_POKER_WORKER_URL=ws://localhost:8787
LIVE_POKER_JWT_SECRET=replace-with-a-random-secret
# Configure the same value in Next and the Convex deployment environment.
LIVE_POKER_CONVEX_SECRET=replace-with-a-random-secret
LIVE_POKER_WEBHOOK_SECRET=replace-with-a-random-secret
LIVE_POKER_WEBHOOK_URL=http://localhost:3000/api/live-poker/record-hand
LIVE_POKER_SETTLEMENT_URL=http://localhost:3000/api/live-poker/settle-player
LIVE_POKER_TURN_TIMEOUT_SECONDS=30
