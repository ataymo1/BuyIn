# Shared local defaults
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Auth / NextAuth
NEXTAUTH_SECRET=replace-with-a-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Convex local development
CONVEX_DEPLOYMENT=replace-with-convex-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://replace-with-your-convex-url.convex.cloud

# Optional production/preview deploy key for Convex deploys
CONVEX_DEPLOY_KEY=replace-with-convex-deploy-key

# Optional database URL; currently not read by the app code
DATABASE_URL=
